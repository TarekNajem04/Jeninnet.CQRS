<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- One Mosquitto container run; pairing the suite with both TFMs would start two brokers. -->
        <DisableGlobalFramework>true</DisableGlobalFramework>
        <TargetFrameworks>net11.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="MQTTnet" />
        <PackageReference Include="MSTest" />
        <PackageReference Include="MSTest.TestAdapter" />
        <PackageReference Include="Testcontainers.Mosquitto" />
        <PackageReference Include="coverlet.collector" PrivateAssets="all" />
        <PackageReference Include="Jeninnet.Assertions" />
        <PackageReference Include="Jeninnet.Assertions.MSTest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Jeninnet.CQRS.Transport.Mqtt\Jeninnet.CQRS.Transport.Mqtt.csproj" />
        <ProjectReference Include="..\Jeninnet.CQRS.Transport.Contracts\Jeninnet.CQRS.Transport.Contracts.csproj" />
    </ItemGroup>

</Project>