<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- The generator/analyzer ships as netstandard2.0 analyzer assets; the global
             multi-target list must not apply. TargetFrameworks (plural) is set because
             a singular TargetFramework does not override a global plural. -->
        <DisableGlobalFramework>true</DisableGlobalFramework>
        <TargetFrameworks>netstandard2.0</TargetFrameworks>
        <AssemblyName>Jeninnet.CQRS.Analyzers</AssemblyName>
        <RootNamespace>Jeninnet.CQRS.Analyzers</RootNamespace>

        <IsPackable>true</IsPackable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

        <!-- Analyzer packages must place their assembly under analyzers/dotnet/cs. -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <DevelopmentDependency>true</DevelopmentDependency>
        <IncludeSymbols>false</IncludeSymbols>
        <Description>Roslyn compile-time misuse analyzers for Jeninnet.CQRS handlers.</Description>
        <PackageTags>cqrs;roslyn;analyzer;dotnet</PackageTags>

        <IsRoslynComponent>true</IsRoslynComponent>
        <OutputItemType>Analyzer</OutputItemType>
        <!-- The compiler/IDE supplies Roslyn at runtime; never ship or register a second copy. -->
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

    <!-- Pack the analyzers under the conventional analyzer path. -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddAnalyzerToPackage</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="AddAnalyzerToPackage">
        <ItemGroup>
            <TfmSpecificPackageFile Include="$(TargetPath)"
                                    PackagePath="analyzers/dotnet/cs" />
            <TfmSpecificPackageFile Include="$(DocumentationFile)"
                                    PackagePath="analyzers/dotnet/cs"
                                    Condition="Exists('$(DocumentationFile)')" />
        </ItemGroup>
    </Target>

</Project>