<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net462;netstandard2.0;net10.0;net11.0</TargetFrameworks>
        <UseCqrsGuard>true</UseCqrsGuard>
        <UseCqrsProcessIdentity>true</UseCqrsProcessIdentity>
        <UseCqrsNetStandardAttributes>true</UseCqrsNetStandardAttributes>
        <Description>CQRS pipeline integration for the Jeninnet idempotency engine.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
        <PackageReference Include="System.Runtime.Caching" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Jeninnet.CQRS\Jeninnet.CQRS.csproj" />
    </ItemGroup>
    
</Project>
