<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>SignalR transport for the Jeninnet CQRS pipeline with automatic reconnection.</Description>
        <DisableGlobalFramework>true</DisableGlobalFramework>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <UseCqrsGuard>true</UseCqrsGuard>
        <UseCqrsNetStandardAttributes>true</UseCqrsNetStandardAttributes>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Jeninnet.CQRS\Jeninnet.CQRS.csproj" />
    </ItemGroup>
    <Import Project="..\shared\Transport\Transport.projitems" Label="Shared" />
</Project>
