<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Description>Azure Service Bus transport for the Jeninnet CQRS pipeline.</Description>
        <DisableGlobalFramework>true</DisableGlobalFramework>
        <TargetFrameworks>netstandard2.0;net10.0;net11.0</TargetFrameworks>
        <UseCqrsGuard>true</UseCqrsGuard>
        <UseCqrsNetStandardAttributes>true</UseCqrsNetStandardAttributes>
        <UseCqrsLock>true</UseCqrsLock>
        <UseCqrsTaskWait>true</UseCqrsTaskWait>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Messaging.ServiceBus" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Jeninnet.CQRS\Jeninnet.CQRS.csproj" />
    </ItemGroup>
    <Import Project="..\shared\Transport\Transport.projitems" Label="Shared" />
</Project>
