{
    "$schema": "./coverage.schema.json",

    "coverage": {
        "resultsDirectory": "TestResults",
        "reportDirectory": "artifacts/coverage",
        "floor": 0.80,

        "reportTypes": [
            "Html",
            "HtmlSummary",
            "TextSummary",
            "Cobertura"
        ]
    },

    "test": {
        "command": "dotnet test",
        "arguments": [
            "--collect:XPlat Code Coverage;Format=cobertura"
        ]
    },

    "reportGenerator": {
        "toolCommand": "reportgenerator",

        "assemblyFilters": [
            "+Jeninnet.CQRS*",
            "-Jeninnet.CQRS.*Tests*",            "-*Benchmarks*",
            "-*Samples*",
            "-*Sample*"
        ],

        "classFilters": [
            "-Microsoft.AspNetCore.OpenApi.Generated*",
            "-System.Runtime.CompilerServices*"
        ]
    },

    "behavior": {
        "openReport": true
    }
}

