    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Jeninnet.CQRS.Analyzers/Jeninnet.CQRS.Analyzers.csproj",
            "Jeninnet.CQRS.Contracts/Jeninnet.CQRS.Contracts.csproj",
