      "dest": "api",
      "properties": {
        "TargetFramework": "netstandard2.0"
      },
      "disableGitFeatures": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/**.md"
        ]
      },
      {
        "files": [
          "index.md",
          "packages.md",
          "XML-DOCS.md",
          "guides/*.md",
          "benchmarks/*.md",
          "adr/*.md"
        ]
      },
      {
        "src": "..",
        "files": [
          "README.md",
          "ROADMAP.md"
        ],
        "dest": "guides"
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "Jeninnet.CQRS API",
      "_appFooter": "Jeninnet B.V. — generated from XML documentation.",
      "_enableSearch": true
    },
    "template": [
      "default",
      "modern"
    ],
    "xrefService": []
  }
}